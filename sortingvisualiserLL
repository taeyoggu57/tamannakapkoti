int main() {
    struct Node *head = NULL;
    int choice, data;

    while (1) {
        printf("\n--- Sorting Visualization Using Linked List ---\n");
        printf("1. Insert Element\n");
        printf("2. Display List\n");
        printf("3. Bubble Sort\n");
        printf("4. Insertion Sort\n");
        printf("5. Selection Sort\n");
        printf("6. Merge Sort\n");
        printf("7. Quick Sort\n");
        printf("8. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
        case 1:
            printf("Enter data: ");
            scanf("%d", &data);
            insertEnd(&head, data);
            break;

        case 2:
            printf("Linked List: ");
            displayList(head);
            break;

        case 3:
            printf("Bubble Sort Visualization:\n");
            bubbleSort(head);
            break;

        case 4:
            printf("Insertion Sort Visualization:\n");
            head = insertionSort(head);
            break;

        case 5:
            printf("Selection Sort Visualization:\n");
            selectionSort(head);
            break;

        case 6:
            printf("Merge Sort Visualization:\n");
            mergeSort(&head);
            break;

        case 7:
            printf("Quick Sort Visualization:\n");
            quickSort(&head);
            break;

        case 8:
            printf("Exiting program...\n");
            exit(0);

        default:
            printf("Invalid choice! Try again.\n");
        }
    }
    return 0;
}
